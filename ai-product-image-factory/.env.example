# ── 图像生成引擎（可选）────────────────────────────────────────────
# 不配置任何 Key 时，系统使用内置的「本地合成引擎」，完全离线可跑通全流程。
# 配置后自动切换为真实 AI 生图模型，本地引擎作为失败兜底。
#
# 可选值：local | gemini | openai
IMAGE_PROVIDER=local

# Google Gemini（图像生成 / 图生图）
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI（gpt-image-1 图像编辑）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 营销文案引擎（可选）────────────────────────────────────────────
# 配置后由 Claude 生成标题与卖点，未配置时使用内置文案引擎。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
